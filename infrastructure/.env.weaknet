# Dart-define file for weak-network testing (weak-network simulation plan, stage 1).
# REST and WS traffic is routed through the toxiproxy listeners declared in
# docker-compose.test.yml, so toxics can be toggled at runtime via the control
# API on 127.0.0.1:8474 while the app behaves as if the network degraded.
#
# Usage (from mobile-flutter):
#   flutter run --dart-define-from-file=../infrastructure/.env.weaknet
#
# API_HOST follows the .env.dev convention (Tailscale IP) so the same file
# serves both the Android emulator (traffic NATs through the host) and a
# physical device on the tailnet. For emulator-only sessions, 10.0.2.2 works
# as an equivalent host alias.
API_HOST=100.100.1.128
API_BASE_URL=http://100.100.1.128:10000/api/v1
WS_BASE_URL=ws://100.100.1.128:10001/v1/ws/connect
