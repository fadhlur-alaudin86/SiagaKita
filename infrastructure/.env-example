# Database Credentials
DB_USER=
DB_PASSWORD=
DB_NAME=siagakita
DB_HOST=postgres
DB_PORT=5432

# Redis Credentials
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# Server Ports
HTTP_PORT=8080
WS_PORT=8081

# JWT
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Whatsapp Gateway
FONNTE_TOKEN=

# Email Gateway — Resend (DIUTAMAKAN, tidak butuh port SMTP)
# Daftar gratis di https://resend.com (3.000 email/bulan gratis)
# Jika diisi, SMTP di bawah diabaikan.
# PENTING: "from" harus domain terverifikasi di Resend
#   → Untuk testing gunakan: Onboarding Resend <onboarding@resend.dev>
RESEND_API_KEY=

# Email Gateway — SMTP (FALLBACK, hanya jika RESEND_API_KEY kosong)
# Catatan: Port 587/465 sering diblokir di VPS cloud (DigitalOcean, AWS, dll.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# pgAdmin Login
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Superadmin (satu akun, dibuat otomatis saat server start)
# Isi manual — jangan commit ke git!
SUPERADMIN_EMAIL=
SUPERADMIN_PASS=

# SMS Fallback Gateway (untuk endpoint /incidents/sms-fallback)
SMS_GATEWAY_SECRET=

# Docker Hub (untuk docker-compose.prod.yml di VPS)
DOCKERHUB_USERNAME=