# Database Credentials
DB_USER=
DB_PASSWORD=
DB_NAME=siagakita
DB_HOST=postgres
DB_PORT=5432

# Redis Credentials
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# Server Ports & Host
API_HOST=localhost
HTTP_PORT=8080
WS_PORT=8081
GO_ENV=development
LOG_PATH=logs/app.log

# Client Flutter API Endpoints (jika menggunakan --dart-define-from-file)
# Lokal:
# API_BASE_URL=http://localhost:8080/api/v1
# WS_BASE_URL=ws://localhost:8081/v1/ws/connect
# Produksi:
# API_BASE_URL=https://api.siagakita.com/api/v1
# WS_BASE_URL=wss://api.siagakita.com/v1/ws/connect

# JWT
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Whatsapp Gateway
FONNTE_TOKEN=

# Email Gateway — Gmail REST API (menggunakan HTTPS port 443, bebas blokir SMTP)
# Memerlukan kredensial OAuth2 dari Google Cloud Console
EMAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# pgAdmin Login
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Superadmin (satu akun, dibuat otomatis saat server start)
# Isi manual — jangan commit ke git!
SUPERADMIN_EMAIL=
SUPERADMIN_PASS=

# SMS Fallback Gateway (untuk endpoint /incidents/sms-fallback)
SMS_GATEWAY_SECRET=

# Docker Hub & Deployment (untuk docker-compose.prod.yml di VPS)
DOCKERHUB_USERNAME=
IMAGE_TAG=latest

# Upload Storage
UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=https://api.siagakita.com/uploads
